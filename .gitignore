# ignore this because nvim config is lua now but vscode is still vimscript
config/nvim/autoload/plug.vim
vscode/plugged

config/nvim/plugged
config/nvim/projects.txt
# Karabiner's active profile and automatic backups are machine-local state.
/config/karabiner/
/stow/karabiner/.config/karabiner/automatic_backups/
/stow/karabiner/.config/karabiner/karabiner.json
config/lvim/plugin/packer_compiled.lua
