# GitHub CLI host data may contain OAuth credentials; only config.yml is Stow-managed.
/config/gh/
/stow/gh/.config/gh/hosts.yml

# Herdr configuration is Stow-managed; runtime state remains local to ~/.config/herdr.
/config/herdr/
/stow/herdr/.config/herdr/.plugins.lock
/stow/herdr/.config/herdr/*.log
/stow/herdr/.config/herdr/*.sock
/stow/herdr/.config/herdr/session.json
